# Copy to .env and adjust. .env is gitignored — never commit real keys.

# --- HydraDB (matches docker-compose.yml defaults) ---
ICHOR_HYDRA_URL=bolt://127.0.0.1:7687
ICHOR_HYDRA_TOKEN=ichor-local-development-token-32b
ICHOR_HYDRA_NAMESPACE=default

# --- MinIO (object storage behind HydraDB) ---
MINIO_ROOT_USER=ichor
MINIO_ROOT_PASSWORD=ichor-dev-secret
ICHOR_BUCKET=ichor

# --- OpenRouter: the Judge (OPTIONAL) -------------------------------------
# Ichor is fully functional with no key at all. The graph decides what is
# CONNECTED on its own; the Judge only weighs an agent's ARGUMENT when it asks
# for the task boundary to be expanded. No key simply means no expansions are
# granted on argument alone.
OPENROUTER_KEY=

# Recommended: openai/gpt-5-mini, with deepseek-v4-flash as the automatic fallback.
#
# Measured on scripts/judge-test.ts — three cases, three runs each. Two cases
# argue for an endpoint the codebase already makes unnecessary (the Judge must
# refuse), and one makes a claim about user behaviour that a call graph cannot
# see (the Judge must ask the developer rather than assert):
#
#   openai/gpt-5-mini            8/9   $2.00/M out
#   deepseek/deepseek-v4-flash   8/9   $0.13/M out
#   openai/gpt-oss-120b          7/9   $0.17/M out  — one run collapsed to 1/3
#   qwen/qwen3.7-flash           6/9   $0.13/M out  — consistently over-refuses
#
# Every model resisted the authoritative "OWASP mandates this" argument, which is
# the behaviour that matters most. Nothing beat the fallback, so it stays: it
# matches the primary on this suite, which is exactly what you want from a
# fallback — degrading to it costs nothing measurable.
#
# The remaining variance is all one case: whether a model ESCALATES a claim it
# cannot check or refuses it outright. Both leading models mostly escalate.
# Refusing everything looks careful and is useless.
#
# Cost is not a factor either way — the Judge only runs when an agent actually
# argues, so a whole hackathon is pennies.
OPENROUTER_MODEL=openai/gpt-5-mini

# Optional overrides
# ICHOR_JUDGE_MODEL=            # takes precedence over OPENROUTER_MODEL
# ICHOR_JUDGE_TIMEOUT_MS=20000
# ICHOR_JUDGE_MAX_PER_TASK=25   # hard cap on Judge calls per task
# ICHOR_JUDGE_MAX_PER_FILE=2    # stops an argument looping on one file

# --- debugging ---
# ICHOR_DEBUG=1                 # mirror hook/judge diagnostics to stderr
#                               # (.ichor/hook.log is always written)
