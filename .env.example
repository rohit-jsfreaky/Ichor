# Copy to .env and adjust. .env is gitignored — never commit real keys.

# --- HydraDB (matches docker-compose.yml defaults) ---
ICHOR_HYDRA_URL=bolt://127.0.0.1:7687
ICHOR_HYDRA_TOKEN=ichor-local-development-token-32b
ICHOR_HYDRA_NAMESPACE=default

# --- MinIO (object storage behind HydraDB) ---
MINIO_ROOT_USER=ichor
MINIO_ROOT_PASSWORD=ichor-dev-secret
ICHOR_BUCKET=ichor

# --- OpenRouter (OPTIONAL) ---
# Ichor runs fully without this. It only powers `--explain`:
# plain-English write-ups, ambiguous-field suggestions, PR comments.
# The LLM never decides what is true — see the AI rule in SCOPE.md.
OPENROUTER_API_KEY=
ICHOR_EXPLAIN_MODEL=
ICHOR_CLASSIFY_MODEL=
