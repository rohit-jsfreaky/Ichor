{
  "name": "ichor-cli",
  "version": "0.1.1",
  "description": "Make every scope expansion explicit while AI coding agents work. Built on HydraDB.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/rohit-jsfreaky/ichor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohit-jsfreaky/ichor.git"
  },
  "bugs": {
    "url": "https://github.com/rohit-jsfreaky/ichor/issues"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "code-graph",
    "scope",
    "typescript",
    "static-analysis",
    "hydradb",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ichor": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "spike": "tsx scripts/spike-tsmorph.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f hydradb",
    "analyze": "tsx scripts/analyze.ts",
    "ingest": "tsx scripts/ingest.ts",
    "scope": "tsx scripts/scope.ts",
    "check": "tsx scripts/check.ts",
    "multi:test": "tsx scripts/multi-repo-test.ts",
    "incremental:test": "tsx scripts/incremental-test.ts",
    "session:test": "tsx scripts/session-test.ts",
    "hook:test": "tsx scripts/hook-test.ts",
    "mcp:test": "node dist/scripts/mcp-test.js",
    "judge:test": "node -r dotenv/config dist/scripts/judge-test.js",
    "delta:test": "tsx scripts/verify-delta.ts",
    "read:test": "tsx scripts/read-test.ts",
    "exported:gate": "node scripts/exported-gate.mjs",
    "analyze:gate": "tsx scripts/analyze-gate.ts",
    "boundary:gate": "tsx scripts/boundary-gate.ts",
    "named:gate": "tsx scripts/named-seed-gate.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "neo4j-driver": "^5.28.1",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
