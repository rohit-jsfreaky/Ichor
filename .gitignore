# ---------------------------------------------------------------- dependencies
node_modules/
.pnp/
.pnp.js
.yarn/

# ---------------------------------------------------------------- build output
dist/
build/
out/
*.tsbuildinfo

# ---------------------------------------------------------------- secrets
# Never commit these. The MinIO/HydraDB dev credentials in docker-compose.yml
# and docker/hydradb-auth-token ARE intentionally tracked: they are throwaway
# local-only defaults, and shipping them is what lets `docker compose up` work
# for anyone cloning this repo without a setup step.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# ---------------------------------------------------------------- Ichor state
# Per-task boundary written by `ichor start`. Machine-local and disposable.
.ichor/

# Agent hook config generated by `ichor init` inside a target repo.
demo/.claude/
demo/.codex/
demo/.ichor/

# Repos cloned locally to analyse. Never vendored into this repo.
targets/

# ---------------------------------------------------------------- demo app
demo/node_modules/
demo/.next/
demo/out/
# Prisma SQLite database and generated client
demo/prisma/*.db
demo/prisma/*.db-journal
demo/prisma/migrations/dev.db*
demo/src/generated/

# ---------------------------------------------------------------- landing page
web/node_modules/
web/.next/
web/out/
web/.vercel/

# ---------------------------------------------------------------- local data
# MinIO / HydraDB volumes if ever bind-mounted instead of named volumes
hydradb-data/
.hydradb/
minio-data/

# ---------------------------------------------------------------- test + tooling
coverage/
.nyc_output/
*.lcov
.vitest/
.eslintcache

# ---------------------------------------------------------------- logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ---------------------------------------------------------------- editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- scratch
tmp/
temp/
*.tmp
*.bak
*.orig
.resolver-baseline/
.ground-truth/

# ---------------------------------------------------- internal working documents
# Build logs, bug ledgers and hackathon planning. These are how the project was
# built, not part of what it is, and several quote pre-fix numbers that the
# README has since corrected — shipping them would publish contradictions.
# docs/MEASUREMENTS.md is deliberately NOT here: it is the README's companion.
BUGS.md
TASKS.md
PROJECT_FINAL.md
SCOPE.md
